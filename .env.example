# Payload CMS and website content database
MONGODB_URI=mongodb://127.0.0.1/enidpath
PAYLOAD_SECRET=replace-with-a-long-random-secret
SITE_URL=http://localhost:3000
PAYLOAD_FETCH_TIMEOUT_MS=2000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
PAYLOAD_RETRY_COOLDOWN_MS=10000

# Vercel Blob (media uploads)
BLOB_READ_WRITE_TOKEN=

# SMTP email (CPanel or any SMTP provider)
SMTP_HOST=mail.enidpath.com
SMTP_PORT=465
SMTP_USER=info@enidpath.com
SMTP_PASS=
SMTP_FROM_ADDRESS=info@enidpath.com
SMTP_FROM_NAME=EnidPath International
